{
  "id": "graphite-mono",
  "name": "Graphite Mono",
  "description": "Hitam putih dengan satu aksen untuk produk minimalis dan premium.",
  "personality": [
    "minimal",
    "premium",
    "restrained",
    "sharp"
  ],
  "tokens": {
    "color_mode": "light",
    "radius": "small",
    "spacing": "comfortable"
  },
  "preferences": {
    "navigation": "top",
    "layout": [
      "sections",
      "list",
      "focused"
    ],
    "density": "comfortable"
  },
  "avoid": [
    "decorative_gradient",
    "glassmorphism",
    "illustration",
    "large_cards"
  ],
  "rules": [
    {
      "if": "the brand wants to feel premium",
      "then": "black and white with color only for status",
      "why": "restraint reads as quality"
    }
  ]
}
