{
  "id": "ocean-analytics",
  "name": "Ocean Analytics",
  "description": "Terang dan padat dengan aksen teal untuk dashboard, laporan dan analitik.",
  "personality": [
    "analytical",
    "fresh",
    "precise",
    "data focused"
  ],
  "tokens": {
    "color_mode": "light",
    "radius": "small",
    "spacing": "compact"
  },
  "preferences": {
    "navigation": "side",
    "layout": [
      "dashboard",
      "table",
      "master-detail"
    ],
    "density": "compact"
  },
  "avoid": [
    "hero_section",
    "large_cards",
    "excessive_whitespace",
    "illustration"
  ],
  "rules": [
    {
      "if": "a page compares many numbers",
      "then": "dense tables and small charts aligned on one grid",
      "why": "analysts scan and compare, decoration slows them down"
    }
  ]
}
